{
  "name": "@cityline/backend",
  "version": "1.0.0",
  "private": true,
  "description": "CITYLINE CONSULTANCY — Backend REST API Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:migrate": "node --import tsx ../node_modules/knex/bin/cli.js --knexfile src/config/knex.config.ts migrate:latest",
    "db:rollback": "node --import tsx ../node_modules/knex/bin/cli.js --knexfile src/config/knex.config.ts migrate:rollback",
    "db:seed": "node --import tsx ../node_modules/knex/bin/cli.js --knexfile src/config/knex.config.ts seed:run",
    "db:validate": "tsx --test tests/database.test.ts",
    "db:test": "node ../scripts/test-db-connection.js",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "queue:process": "tsx src/scripts/process-notification-queue.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "hash-wasm": "^4.12.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
