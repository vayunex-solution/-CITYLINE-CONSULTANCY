# CITYLINE CONSULTANCY — Backend Environment Variables
# Copy to .env for local development

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Private Storage Directory (Development default: ~/clc_storage/, Production: /home/<cpanel_user>/clc_storage/)
STORAGE_ROOT=~/clc_storage

# Database Connection (Phase 2 & Phase 3 — Verified Engine: MariaDB 10.11)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clc_db
DB_USER=clc_user
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_TIMEOUT_MS=10000

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Admin Authentication & Security Subsystem (Phase 4)
AUTH_TOKEN_SECRET=development_insecure_auth_token_secret_must_be_at_least_32_characters_long_for_security
AUTH_TOKEN_TTL=30m
AUTH_COOKIE_NAME=clc_admin_token
AUTH_CSRF_COOKIE_NAME=clc_csrf_token
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# Phase 7: SMTP Transactional Notification Subsystem
SMTP_HOST=mail.citylineconsultancy.com
SMTP_PORT=465
SMTP_USER=no-reply@citylineconsultancy.com
SMTP_PASSWORD=
SMTP_FROM="Cityline Consultancy <no-reply@citylineconsultancy.com>"
SMTP_SECURE=true
SMTP_POOL=true
NOTIFICATION_ADMIN_EMAIL=no-reply@citylineconsultancy.com
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=20
