# CITYLINE CONSULTANCY — Backend Environment Variables
# Copy to .env for local development

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Private Storage Directory (outside web root)
STORAGE_ROOT=../storage

# Database Connection (Phase 2 Ownership — Engine UNVERIFIED)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clc_db
DB_USER=clc_user
DB_PASSWORD=

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

# Future Subsystem Placeholders (Phase 4 / Phase 7)
SESSION_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
