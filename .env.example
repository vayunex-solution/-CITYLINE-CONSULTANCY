# ==============================================================================
# CITYLINE CONSULTANCY — Root Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env IN LOCAL DEVELOPMENT (NEVER COMMIT .env TO GIT)
# NOTE: Production database engine & credentials remain OPEN / UNVERIFIED
# ==============================================================================

# --- APPLICATION RUNTIME ---
NODE_ENV=development

# --- BACKEND API CONFIGURATION ---
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- PRIVATE FILE STORAGE SUBSYSTEM ---
# Development default: ~/clc_storage/ (resolves to user home directory, outside repository)
# Production cPanel target: /home/<cpanel_user>/clc_storage/ (strictly outside public_html)
# MUST NEVER BE LOCATED WITHIN public_html, frontend/public, backend/public, or repo root
STORAGE_ROOT=~/clc_storage

# --- DATABASE CONNECTION ABSTRACTION (PHASE 2) ---
# Verified Engine: MariaDB 10.11 (10.11.16-MariaDB-cll-lve)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cityline_consultancy_dev
DB_USER=clc_db_user
DB_PASSWORD=your_local_db_password_placeholder
DB_SSL=false
DB_CONNECTION_LIMIT=5

# --- SMTP NOTIFICATION SUBSYSTEM (PHASE 7 PREPARATION) ---
# Decoupled mailer configuration (Placeholders only)
SMTP_HOST=mail.citylineconsultancy.ae
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@citylineconsultancy.ae
SMTP_PASS=your_smtp_password_placeholder
SMTP_FROM="CITYLINE CONSULTANCY <info@citylineconsultancy.ae>"
SMTP_ADMIN_RECIPIENT=admin@citylineconsultancy.ae

# --- SECURITY & SESSIONS (PHASE 4 PREPARATION) ---
SESSION_SECRET=change_me_to_a_random_64_character_cryptographic_secret_in_dev

# --- FRONTEND CLIENT ENVIRONMENT ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
