# ==============================================================================
# CITYLINE CONSULTANCY — Root Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env IN LOCAL DEVELOPMENT (NEVER COMMIT .env TO GIT)
# NOTE: Production database engine & credentials remain OPEN / UNVERIFIED
# ==============================================================================

# --- APPLICATION RUNTIME ---
NODE_ENV=development

# --- BACKEND API CONFIGURATION ---
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- PRIVATE FILE STORAGE SUBSYSTEM ---
# Development default: ~/clc_storage/ (resolves to user home directory, outside repository)
# Production cPanel target: /home/<cpanel_user>/clc_storage/ (strictly outside public_html)
# MUST NEVER BE LOCATED WITHIN public_html, frontend/public, backend/public, or repo root
STORAGE_ROOT=~/clc_storage

# --- DATABASE CONNECTION ABSTRACTION (PHASE 2 / PHASE 3) ---
# Verified Engine: MariaDB 10.11 (10.11.16-MariaDB-cll-lve)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cityline_consultancy_dev
DB_USER=clc_db_user
DB_PASSWORD=your_local_db_password_placeholder
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_TIMEOUT_MS=10000

# --- SMTP NOTIFICATION SUBSYSTEM (PHASE 7) ---
# Decoupled outbox worker mailer configuration (Placeholders only)
SMTP_HOST=mail.citylineconsultancy.com
SMTP_PORT=465
SMTP_USER=no-reply@citylineconsultancy.com
SMTP_PASSWORD=
SMTP_FROM="Cityline Consultancy <no-reply@citylineconsultancy.com>"
SMTP_SECURE=true
SMTP_POOL=true
NOTIFICATION_ADMIN_EMAIL=no-reply@citylineconsultancy.com
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=20

# --- ADMIN AUTHENTICATION & SECURITY (PHASE 4) ---
AUTH_TOKEN_SECRET=development_insecure_auth_token_secret_must_be_at_least_32_characters_long_for_security
AUTH_TOKEN_TTL=30m
AUTH_COOKIE_NAME=clc_admin_token
AUTH_CSRF_COOKIE_NAME=clc_csrf_token
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MS=900000

# --- FRONTEND CLIENT ENVIRONMENT ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
